# ==============================================================================
# RetailPulse: Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file or GCP service account JSON files to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Source Configuration
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=retail_source
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# ------------------------------------------------------------------------------
# 2. Google Cloud / BigQuery Configuration
# ------------------------------------------------------------------------------
GCP_PROJECT_ID=your_gcp_project_id_here
GCP_REGION=US
BIGQUERY_RAW_DATASET=raw_retail
BIGQUERY_ANALYTICS_DATASET=analytics_retail

# Path to Google Cloud service account JSON key file
GOOGLE_APPLICATION_CREDENTIALS=keys/gcp_service_account.json

# ------------------------------------------------------------------------------
# 3. Airbyte Connection Parameters (Reference)
# ------------------------------------------------------------------------------
AIRBYTE_HOST=http://localhost:8000
AIRBYTE_CONNECTION_NAME=PostgreSQL_to_BigQuery_Retail_Sync
