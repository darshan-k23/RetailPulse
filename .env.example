# ==============================================================================
# RetailPulse: Environment Configuration Template (.env.example)
#
# Instructions:
# 1. Copy this file to '.env':
#      Windows PowerShell: Copy-Item .env.example .env
#      Bash:               cp .env.example .env
# 2. Fill in your project-specific credentials and connection IDs.
# 3. NEVER commit your actual '.env' or JSON service account keys to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Cloud Platform & BigQuery Configuration
# ------------------------------------------------------------------------------
# Your Google Cloud Project ID hosting raw_retail and analytics_retail datasets
GCP_PROJECT_ID=your_gcp_project_id_here

# BigQuery Dataset Location (e.g. US, EU, asia-south1)
GCP_REGION=US

# Local path to your downloaded GCP Service Account JSON Key
# Recommended location: keys/gcp_service_account.json (gitignored)
GOOGLE_APPLICATION_CREDENTIALS=keys/gcp_service_account.json

# Target BigQuery Datasets
BQ_RAW_DATASET=raw_retail
BQ_ANALYTICS_DATASET=analytics_retail

# ------------------------------------------------------------------------------
# 2. PostgreSQL Source Database (OLTP Orders DB)
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=retail_source
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ------------------------------------------------------------------------------
# 3. Airbyte Ingestion Service (ELT Postgres -> BigQuery)
# ------------------------------------------------------------------------------
AIRBYTE_HOST=localhost
AIRBYTE_PORT=8000
AIRBYTE_USERNAME=admin
AIRBYTE_PASSWORD=password

# Connection UUID from Airbyte UI URL:
# http://localhost:8000/workspaces/<id>/connections/<UUID>
AIRBYTE_CONNECTION_ID=your_airbyte_connection_uuid_here

# ------------------------------------------------------------------------------
# 4. dbt Core Transformation Layer
# ------------------------------------------------------------------------------
DBT_PROJECT_DIR=dbt/retailpulse_dbt
DBT_PROFILES_DIR=dbt/retailpulse_dbt

# ------------------------------------------------------------------------------
# 5. Apache Airflow Orchestration
# ------------------------------------------------------------------------------
AIRFLOW_UID=50000
AIRFLOW_CONN_AIRBYTE_DEFAULT=airbyte://admin:password@host.docker.internal:8000
AIRFLOW__CORE__LOAD_EXAMPLES=False
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=False

# ------------------------------------------------------------------------------
# 6. Streamlit Conversational BI Dashboard
# ------------------------------------------------------------------------------
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true
STREAMLIT_THEME_BASE=light
